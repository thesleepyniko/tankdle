# Run `bun run setup` to create .env with the empty secrets below generated.

# Postgres (used by docker-compose.yaml)
POSTGRES_USER="tankdle"
POSTGRES_PASSWORD="" # generated
POSTGRES_DB="tankdle"

# Drizzle / local dev (the compose app builds its own URL pointing at the db container)
DATABASE_URL="" # generated from the POSTGRES_* values above
ENCRYPTION_KEY="" # generated, minimum 256 bits long
DISCORD_CLIENT_ID="" # self explanatory
DISCORD_CLIENT_SECRET=""
IMAGE_DIR="./data/images"

# Docker only
ORIGIN="http://localhost:8080" # public URL, e.g. https://tankdle.example.com behind a proxy
APP_PORT=8080
